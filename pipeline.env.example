# Copy this file to pipeline.env and fill in the blanks.
# Use the same Postgres values as the "Postgres account" credential in n8n.
# pipeline.env is in .gitignore, so the password never reaches GitHub.

PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=postgres
PGPASSWORD=

SQLSERVER=localhost
SQLDATABASE=DonationsDW
