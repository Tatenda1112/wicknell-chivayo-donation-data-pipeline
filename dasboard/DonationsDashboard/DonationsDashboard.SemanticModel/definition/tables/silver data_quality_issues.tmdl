	partition 'silver data_quality_issues' = m
		mode: import
		source =
				let
				    Source = Sql.Database("DESKTOP-07NN6T8", "DonationsDW"),
				    silver_data_quality_issues = Source{[Schema="silver",Item="data_quality_issues"]}[Data],
				    AddLabel = Table.AddColumn(silver_data_quality_issues, "issue_label", each
				        if [issue_type] = "NOT_COUNTED_IN_TOTAL" then
				            (if [description] <> null and Text.StartsWith([description], "Duplicate") then "Duplicate"
				             else if [description] <> null and Text.StartsWith([description], "Declined") then "Declined"
				             else if [description] <> null and Text.StartsWith([description], "Not a donation") then "Not a donation"
				             else if [description] <> null and Text.StartsWith([description], "Family") then "Family gift"
				             else "Not counted (other)")
				        else if [issue_type] = "EXCLUDED_NOT_A_DONATION" then "Excluded row"
				        else if [issue_type] = "OVERLAP_REVIEW" then "Overlap warning"
				        else if [issue_type] = "LLM_CORRECTION" then "LLM correction"
				        else if [issue_type] = "REVIEW_FLAG" then "Review flag"
				        else if [issue_type] = "AMOUNT_NOT_COMPUTABLE" then "Amount not computable"
				        else [issue_type], type text)
				in
				    AddLabel

	annotation PBI_ResultType = Table

