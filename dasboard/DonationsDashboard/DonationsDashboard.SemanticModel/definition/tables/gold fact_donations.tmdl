table 'gold fact_donations'
	lineageTag: 1edf50a8-66a9-4a60-8718-6be08d247b68

	/// Cash (money rows only) that counts toward the total.
	measure 'Total Cash USD' = CALCULATE ( SUM ( 'gold fact_donations'[cash_amount_usd] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: 18e8f9f7-f7b4-45ce-9b68-8f215d743388

	/// Cash with status Delivered, Donated or Previously Donated.
	measure 'Delivered Cash' = CALCULATE ( [Total Cash USD], KEEPFILTERS ( 'gold dim_status'[status_group] = "Delivered" ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: ed721276-2a08-471d-817f-9157ff389504

	/// Cash that has been promised but not yet delivered.
	measure 'Promised Cash' = CALCULATE ( [Total Cash USD], KEEPFILTERS ( 'gold dim_status'[status_group] = "Promised" ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: eb2edffb-6ebf-4a41-bf04-e3a082c4cadb

	/// Delivered cash as a share of all counted cash.
	measure 'Delivery Rate' = DIVIDE ( [Delivered Cash], [Total Cash USD] )
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 29b609f3-db21-4120-950b-77523b367533

	/// Number of vehicles (counted lines only).
	measure 'Total Vehicles' = CALCULATE ( SUM ( 'gold fact_donations'[quantity] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ), KEEPFILTERS ( 'gold dim_donation_type'[donation_type] = "Vehicle" ) )
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 33775657-84ab-4320-8aa3-5603d97949df

	/// Stated value of vehicles.
	measure 'Vehicle Value USD' = CALCULATE ( SUM ( 'gold fact_donations'[asset_value_usd] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ), KEEPFILTERS ( 'gold dim_donation_type'[donation_type] = "Vehicle" ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: 1f474522-ae70-41e1-974a-68306174fcba

	/// Number of houses (counted lines only).
	measure Houses = CALCULATE ( SUM ( 'gold fact_donations'[quantity] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ), KEEPFILTERS ( 'gold dim_donation_type'[donation_type] = "House" ) )
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 293d4be7-e3ba-45d7-86a5-26f60272c068

	/// Stated value of houses.
	measure 'House Value USD' = CALCULATE ( SUM ( 'gold fact_donations'[asset_value_usd] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ), KEEPFILTERS ( 'gold dim_donation_type'[donation_type] = "House" ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: eaec3a5f-0eee-440c-8ba3-318acf63838e

	/// Stated value of other giving (equipment, fuel, education and so on).
	measure 'Other Giving Value USD' = CALCULATE ( SUM ( 'gold fact_donations'[asset_value_usd] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ), KEEPFILTERS ( 'gold dim_donation_type'[donation_type] = "Other" ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: 9bf95aa5-f4e2-4151-a540-e719f98bcf23

	/// Distinct recipients with at least one counted donation line.
	measure Recipients = CALCULATE ( DISTINCTCOUNT ( 'gold fact_donations'[recipient_key] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ) )
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 1426b9b4-88f2-4744-a64d-c2202e4dd4b4

	/// Cash plus the stated value of vehicles, houses and other gifts (counted lines only).
	measure 'Total Value USD' = CALCULATE ( SUM ( 'gold fact_donations'[cash_amount_usd] ) + SUM ( 'gold fact_donations'[asset_value_usd] ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: a229a296-b2d1-41ce-a4b4-57d63b7d070a

	/// Total value for the 5 recipients with the highest total value in the current selection.
	measure 'Top 5 Value' = VAR t = TOPN ( 5, FILTER ( ALLSELECTED ( 'gold dim_recipient'[recipient_name] ), NOT ISBLANK ( [Total Value USD] ) ), [Total Value USD], DESC, 'gold dim_recipient'[recipient_name], ASC ) RETURN CALCULATE ( [Total Value USD], KEEPFILTERS ( t ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: 344e99fe-fc2d-4ab6-b14c-d5f5c106e0ca

	/// Cash for the 10 recipients with the most cash in the current selection.
	measure 'Top 10 Cash' = VAR t = TOPN ( 10, FILTER ( ALLSELECTED ( 'gold dim_recipient'[recipient_name] ), NOT ISBLANK ( [Total Cash USD] ) ), [Total Cash USD], DESC, 'gold dim_recipient'[recipient_name], ASC ) RETURN CALCULATE ( [Total Cash USD], KEEPFILTERS ( t ) )
		formatString: \$#,0
		displayFolder: Dashboard
		lineageTag: c57b317e-cf65-4e68-9494-20404d161078

	/// Vehicles for the 10 recipients with the most vehicles in the current selection.
	measure 'Top 10 Vehicles' = VAR t = TOPN ( 10, FILTER ( ALLSELECTED ( 'gold dim_recipient'[recipient_name] ), NOT ISBLANK ( [Total Vehicles] ) ), [Total Vehicles], DESC, 'gold dim_recipient'[recipient_name], ASC ) RETURN CALCULATE ( [Total Vehicles], KEEPFILTERS ( t ) )
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: a4ef2cf6-6698-40e2-8af4-a20296565b22

	/// Donation lines included in the totals.
	measure 'Donation Lines Counted' = CALCULATE ( COUNTROWS ( 'gold fact_donations' ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = TRUE () ) ) + 0
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: b069a056-49bc-4a48-baa4-d08aaac11aa5

	/// Repeated pledges, declined gifts and non-donations kept for audit but not added.
	measure 'Rows Not Counted' = CALCULATE ( COUNTROWS ( 'gold fact_donations' ), KEEPFILTERS ( 'gold fact_donations'[counts_toward_total] = FALSE () ) ) + 0
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 021e09d4-341f-4a3d-875b-1cf348eb54bd

	/// Fields corrected after reviewing the LLM extraction.
	measure 'LLM Corrections' = CALCULATE ( COUNTROWS ( 'silver data_quality_issues' ), KEEPFILTERS ( 'silver data_quality_issues'[issue_type] = "LLM_CORRECTION" ) ) + 0
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 5fce8df0-4adb-4de0-9ce2-c360a776d23c

	/// Data quality issues logged in Silver.
	measure Issues = COUNTROWS ( 'silver data_quality_issues' ) + 0
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 415d05c8-fc83-45ba-9a32-0f309ac6f202

	/// Extracted rows excluded because they are not donation lines.
	measure 'Excluded Rows' = COUNTROWS ( 'silver excluded' ) + 0
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 0d054869-65b8-4816-b345-6a917a4bc590

