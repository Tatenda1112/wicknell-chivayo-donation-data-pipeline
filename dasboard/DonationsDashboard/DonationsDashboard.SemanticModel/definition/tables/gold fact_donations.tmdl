	partition 'gold fact_donations' = m
		mode: import
		source =
				let
				    Source = Sql.Database("DESKTOP-07NN6T8", "DonationsDW"),
				    gold_fact_donations = Source{[Schema="gold",Item="fact_donations"]}[Data]
				in
				    gold_fact_donations

