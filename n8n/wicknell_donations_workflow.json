    {
      "parameters": {
        "text": "=Tweet ID: {{$json.tweet_id}}\nPost date: {{$json.created_at}}\n\nTweet text:\n{{$json.tweet_text}}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tweet_id\": {\n      \"type\": \"string\",\n      \"description\": \"Copy the exact Tweet ID supplied in the input.\"\n    },\n    \"is_donation\": {\n      \"type\": \"boolean\",\n      \"description\": \"True when the post announces, promises, delivers or describes one or more cash or non-cash donations. Donations include money, vehicles, property, equipment, computers, school support, medical support and other material gifts.\"\n    },\n    \"donations\": {\n      \"type\": \"array\",\n      \"description\": \"Create one record for every independently valued gift. Separate different gifts and independently allocated gifts into separate records. When one amount is shared across several recipients or projects, create one record only, list every recipient in beneficiary_names and set allocation_scope to Shared. Never repeat a shared total for every beneficiary.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"gift_number\": {\n            \"type\": \"integer\",\n            \"description\": \"Sequential gift number beginning at 1 within this post.\"\n          },\n          \"recipient_name\": {\n            \"type\": \"string\",\n            \"description\": \"Name of the primary recipient. For a shared allocation, use an appropriate collective name such as Gandami Community Projects.\"\n          },\n          \"beneficiary_names\": {\n            \"type\": \"array\",\n            \"description\": \"List every named person, institution, school, church, trust, community or organization benefiting from this gift. For an individual gift, include the individual recipient. Do not omit names.\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"recipient_type\": {\n            \"type\": \"string\",\n            \"description\": \"Use Person, School, Church, Trust, Organization, Community, Government Institution, Group or Other.\"\n          },\n          \"allocation_scope\": {\n            \"type\": \"string\",\n            \"description\": \"Use Individual when the gift belongs to one recipient; Per Recipient when a stated amount or item is given to each member; Shared when one total amount jointly covers several named beneficiaries; or Group when recipients are described collectively and their individual names are unknown.\"\n          },\n          \"donation_type\": {\n            \"type\": \"string\",\n            \"description\": \"Use Cash, Vehicle, Equipment, Property, Education Support, Medical Support, Service or Other.\"\n          },\n          \"item_name\": {\n            \"type\": \"string\",\n            \"description\": \"Specific item or support provided, such as Cash, Toyota Land Cruiser 300 Series ZX, Toyota Coaster Bus, Single-Cab Pickup, Desktop Computer, Laptop, Printer, School Upgrading or Clinic Upgrading.\"\n          },\n          \"quantity\": {\n            \"type\": \"number\",\n            \"description\": \"Number of items or known recipients covered by this gift. Use 0 only when the quantity is not stated and cannot be determined directly.\"\n          },\n          \"amount_original\": {\n            \"type\": \"number\",\n            \"description\": \"Exact total monetary amount explicitly stated for this distinct gift. If one total amount jointly covers multiple beneficiaries, create only one record, store that total once, set allocation_scope to Shared and list all recipients in beneficiary_names. For a per-recipient amount, do not place it here unless the total is also explicitly stated. Use 0 for non-cash gifts without a stated value.\"\n          },\n          \"amount_per_recipient\": {\n            \"type\": \"number\",\n            \"description\": \"Amount explicitly stated for each recipient, such as USD 1500 each or USD 10000 each. Use 0 when there is no per-recipient amount. Do not invent a total when the number of recipients is unknown.\"\n          },\n          \"currency\": {\n            \"type\": \"string\",\n            \"description\": \"Currency code such as USD, ZAR, ZWG, GBP or EUR. Use an empty string for non-cash gifts without a stated monetary value.\"\n          },\n          \"amount_usd\": {\n            \"type\": \"number\",\n            \"description\": \"Copy amount_original when currency is USD. For a Per Recipient allocation, use the USD amount per recipient only when amount_original is not stated. Use 0 for other currencies or non-cash gifts without a stated value. Never invent exchange rates.\"\n          },\n          \"purpose\": {\n            \"type\": \"string\",\n            \"description\": \"Reason for the donation, such as fuel, education, church service, transportation, technology, school development, healthcare or community development.\"\n          },\n          \"donation_date\": {\n            \"type\": \"string\",\n            \"description\": \"Date in YYYY-MM-DD format. Use the supplied post date for a current donation announcement unless another donation date is explicitly stated.\"\n          },\n          \"country\": {\n            \"type\": \"string\",\n            \"description\": \"Country of the recipient or project. Use an empty string when it cannot be identified from the post.\"\n          },\n          \"location\": {\n            \"type\": \"string\",\n            \"description\": \"Town, city, district, province or specific place associated with the recipient or project. Use an empty string when unknown.\"\n          },\n          \"donation_theme\": {\n            \"type\": \"string\",\n            \"description\": \"Choose the best theme: Education & Youth, Health & Medicine, Religion, Sports, Housing, Transport, Economic Opportunity & Livelihoods, Humanitarian & Emergency, Arts Culture & Media, Community Development or General Other.\"\n          },\n          \"commitment_status\": {\n            \"type\": \"string\",\n            \"description\": \"Use Promised for future commitments, Donated when the author states the donation is being made, Delivered when receipt or delivery is confirmed, or Previously Donated when describing an earlier donation.\"\n          },\n          \"source_excerpt\": {\n            \"type\": \"string\",\n            \"description\": \"A short exact excerpt from the post that directly supports the recipient, gift and amount. Do not add information that is absent from the post.\"\n          },\n          \"confidence_score\": {\n            \"type\": \"number\",\n            \"description\": \"Confidence between 0 and 1 that this individual gift record is accurate.\"\n          },\n          \"ai_explanation\": {\n            \"type\": \"string\",\n            \"description\": \"Briefly explain the evidence for this gift and whether its value is individual, per-recipient, shared or unstated.\"\n          }\n        },\n        \"required\": [\n          \"gift_number\",\n          \"recipient_name\",\n          \"beneficiary_names\",\n          \"recipient_type\",\n          \"allocation_scope\",\n          \"donation_type\",\n          \"item_name\",\n          \"quantity\",\n          \"amount_original\",\n          \"amount_per_recipient\",\n          \"currency\",\n          \"amount_usd\",\n          \"purpose\",\n          \"donation_date\",\n          \"country\",\n          \"location\",\n          \"donation_theme\",\n          \"commitment_status\",\n          \"source_excerpt\",\n          \"confidence_score\",\n          \"ai_explanation\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"tweet_id\",\n    \"is_donation\",\n    \"donations\"\n  ]\n}",
        "options": {}
      },
