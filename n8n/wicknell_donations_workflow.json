      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{\n{\n  \"donation_key\": String($json.output.tweet_id) + \"-\" + String($json[\"output.donations\"].gift_number),\n  \"tweet_id\": String($json.output.tweet_id),\n  \"recipient_name\": $json[\"output.donations\"].recipient_name,\n  \"beneficiary_names\": JSON.stringify($json[\"output.donations\"].beneficiary_names),\n  \"recipient_type\": $json[\"output.donations\"].recipient_type,\n  \"allocation_scope\": $json[\"output.donations\"].allocation_scope,\n  \"donation_type\": $json[\"output.donations\"].donation_type,\n  \"item_name\": $json[\"output.donations\"].item_name,\n  \"quantity\": Number($json[\"output.donations\"].quantity || 0),\n  \"donation_description\": $json[\"output.donations\"].item_name + \" — \" + $json[\"output.donations\"].purpose,\n  \"amount_original\": Number($json[\"output.donations\"].amount_original) || null,\n  \"amount_per_recipient\": Number($json[\"output.donations\"].amount_per_recipient) || null,\n  \"currency\": $json[\"output.donations\"].currency || null,\n  \"amount_usd\": Number($json[\"output.donations\"].amount_usd) || null,\n  \"purpose\": $json[\"output.donations\"].purpose,\n  \"donation_date\": $json[\"output.donations\"].donation_date || null,\n  \"country\": $json[\"output.donations\"].country || null,\n  \"location\": $json[\"output.donations\"].location || null,\n  \"donation_theme\": $json[\"output.donations\"].donation_theme,\n  \"commitment_status\": $json[\"output.donations\"].commitment_status,\n  \"source_excerpt\": $json[\"output.donations\"].source_excerpt,\n  \"confidence_score\": Number($json[\"output.donations\"].confidence_score),\n  \"ai_explanation\": $json[\"output.donations\"].ai_explanation\n}\n}}",
        "options": {}
      },
